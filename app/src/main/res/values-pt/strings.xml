<?xml version="1.0" encoding="utf-8"?>
<!-- Portuguese (Brazil). Used when the phone's or the app's language is
     Portuguese; same keys as values/strings.xml. Note: in Portuguese, Android's
     plural form "one" covers 0 and 1 ("many" is for numbers like a million).
