<?xml version="1.0" encoding="utf-8"?>
<!-- What Android may copy out of the app (Android 12+).
     cloud-backup: nothing (no cloud sync). Every data domain is excluded.
     device-transfer: not listed, so the default applies: when moving to a new
     phone with a cable/Wi-Fi transfer, the data comes along. That's local,
     not cloud. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
