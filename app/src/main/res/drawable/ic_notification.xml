<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for reminders: the launcher's leaf, cropped to its own box.
     Android draws notification icons as a white silhouette, so only the shape
     matters. The group's translate moves the leaf (drawn at about 34..78 in the
     launcher's 108-unit canvas) into this 48-unit canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <group
        android:translateX="-32"
        android:translateY="-32">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M74,34 C50,34 36,46 36,64 C36,68 37,71 38,74 C42,60 52,50 64,46 C54,52 46,62 42,76 C45,77 48,78 52,78 C68,78 76,62 74,34 Z" />
    </group>
</vector>
