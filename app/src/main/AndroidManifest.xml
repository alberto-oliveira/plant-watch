<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest tells Android what the app contains (activities, receivers, ...)
     and which permissions it needs. The package name comes from `namespace`
     in app/build.gradle.kts, so it is not repeated here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to show the daily reminder (Android 13+ also asks the user at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to fetch sunshine data from Open-Meteo. A "normal" permission:
         granted at install, no dialog. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- android:name: our Application subclass, created once at process start.
         Backup: no cloud backup of app data to the Google account (no cloud sync;
         backups will come from a JSON export instead).
         - dataExtractionRules: the Android 12+ rules (see res/xml/data_extraction_rules.xml).
         - allowBackup="false": the older switch, kept as an explicit opt-out.
         localeConfig: the app's languages, for Android's per-app language setting. -->
    <application
        android:name=".PlantWatchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlantWatch">

        <!-- The single activity. The intent filter makes it the launcher entry. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles the reminder's Done / Snooze buttons. exported="false": only
             this app's own notification can trigger it. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- The "Due today" home-screen widget. exported="true" is required:
             the launcher (another app) sends it the widget broadcasts. -->
        <receiver
            android:name=".widget.DueTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plant_watch_widget_info" />
        </receiver>
    </application>

</manifest>
