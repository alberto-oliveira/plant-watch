# --- Gradle / build output ---
.gradle/
build/
.kotlin/

# Keep the Gradle wrapper jar (needed by ./gradlew), but ignore other jars
*.jar
!gradle/wrapper/gradle-wrapper.jar

# --- Local machine config (never commit) ---
local.properties
*.code-workspace

# --- IDE ---
.idea/
*.iml
.vscode/
captures/
.externalNativeBuild/
.cxx/

# --- Build artifacts and signing (never commit) ---
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore
release/

# --- Logs / crash dumps ---
*.log
hs_err_pid*
replay_pid*

# --- Java leftovers from the original template ---
*.class
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
